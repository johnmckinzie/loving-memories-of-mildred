<!DOCTYPE html>
<html>
<head>
    <title>Loving Memories of Mildred</title>
    <style>
        body { font-family: 'Georgia', serif; background: #fdfaf7; color: #4e342e; max-width: 700px; margin: 40px auto; padding: 20px; text-align: center; }
        .recipe-list { list-style: none; padding: 0; }
        .recipe-item { margin: 15px 0; }
        .recipe-item a { font-size: 1.2em; color: #8d6e63; text-decoration: none; font-weight: bold; }
        .recipe-item a:hover { text-decoration: underline; }
    </style>
</head>
<body>
    <h1>Loving Memories of Mildred</h1>
    <p>A collection of her kitchen legacy.</p>
    <hr>
    <ul class="recipe-list">
    {%- for recipe in collections.all -%}
        {%- if recipe.url != '/' -%}
        <li class="recipe-item">
            <a href="{{ recipe.url }}">🌸 {{ recipe.fileSlug | replace("-", " ") | replace("_", " ") | capitalize }}</a>
        </li>
        {%- endif -%}
    {%- endfor -%}
    </ul>
</body>
</html>
