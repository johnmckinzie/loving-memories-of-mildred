---
permalink: /index.html
---
<!DOCTYPE html>
<html>
<head>
    <title>Loving Memories of Mildred</title>
    <style>
        body { font-family: 'Georgia', serif; background: #fdfaf7; color: #4e342e; max-width: 900px; margin: 40px auto; padding: 20px; }
        h1 { text-align: center; color: #5d4037; font-size: 2.5em; }
        
        /* Nested TOC */
        .toc { background: #efebe9; padding: 25px; border-radius: 8px; margin-bottom: 40px; border: 1px solid #d7ccc8; }
        .toc h2 { margin-top: 0; font-size: 1.1em; color: #5d4037; text-transform: uppercase; border-bottom: 1px solid #d7ccc8; padding-bottom: 5px; }
        .toc-list { list-style: none; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }
        .toc-sec { font-weight: bold; }
        .toc-sub { list-style: none; padding-left: 15px; font-weight: normal; font-size: 0.9em; }
        .toc a { color: #8d6e63; text-decoration: none; }

        /* Sections */
        .major-section { margin-bottom: 50px; }
        .major-title { font-size: 2em; color: #5d4037; border-bottom: 3px solid #d7ccc8; text-transform: capitalize; }
        .sub-section { margin: 20px 0 10px 20px; }
        .sub-title { color: #8d6e63; font-style: italic; font-size: 1.3em; text-transform: capitalize; }
        
        .recipe-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
        .recipe-link { 
            background: white; padding: 12px; border: 1px solid #e0d7d5; 
            border-radius: 4px; text-decoration: none; color: #4e342e; text-align: center; display: block;
        }
        .recipe-link:hover { background: #fffbf0; border-color: #8d6e63; }
    </style>
</head>
<body>
    <h1>Loving Memories of Mildred</h1>

    <nav class="toc">
        <h2>Sections</h2>
        <ul class="toc-list">
        {% set lastSec = "" %}
        {% for recipe in collections.all | sortByFilePath %}
          {% if recipe.url != '/' %}
            {% set sec = recipe.filePathStem | getPathPart(0) %}
            {% set sub = recipe.filePathStem | getPathPart(1) %}
            {% if sec != lastSec %}
                {% if lastSec != "" %}</ul></li>{% endif %}
                <li class="toc-sec"><a href="#{{ sec | slugify }}">{{ sec | replace("-", " ") | capitalize }}</a><ul class="toc-sub">
                {% set lastSec = sec %}{% set lastSub = "" %}
            {% endif %}
            {% if sub != lastSub %}
                <li><a href="#{{ sec | slugify }}-{{ sub | slugify }}">{{ sub | replace("-", " ") | capitalize }}</a></li>
                {% set lastSub = sub %}
            {% endif %}
          {% endif %}
        {% endfor %}
        </ul></li></ul>
    </nav>

    {% set lastMajor = "" %}{% set lastSub = "" %}
    {% for recipe in collections.all | sortByFilePath %}
      {% if recipe.url != '/' %}
        {% set currentMajor = recipe.filePathStem | getPathPart(0) %}
        {% set currentSub = recipe.filePathStem | getPathPart(1) %}

        {% if currentMajor != lastMajor %}
            {% if lastMajor != "" %}</div></div></div>{% endif %}
            <div class="major-section" id="{{ currentMajor | slugify }}">
                <h2 class="major-title">{{ currentMajor | replace("-", " ") }}</h2>
                {% set lastMajor = currentMajor %}{% set lastSub = "" %}
        {% endif %}

        {% if currentSub != lastSub %}
            {% if lastSub != "" %}</div></div>{% endif %}
            <div class="sub-section" id="{{ currentMajor | slugify }}-{{ currentSub | slugify }}">
                <h3 class="sub-title">{{ currentSub | replace("-", " ") }}</h3>
                <div class="recipe-grid">
                {% set lastSub = currentSub %}
        {% endif %}

        <a href="{{ recipe.url }}" class="recipe-link">{{ recipe.data.title }}</a>
      {% endif %}
    {% endfor %}
    </div></div></div>
</body>
</html>
