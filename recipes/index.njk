permalink: /index.html
---
<!DOCTYPE html>
<html>
<head>
    <title>Loving Memories of Mildred</title>
    <style>
        body { font-family: 'Georgia', serif; background: #fdfaf7; color: #4e342e; max-width: 800px; margin: 40px auto; padding: 20px; }
        h1 { text-align: center; color: #5d4037; }
        .recipe-item { margin: 15px 0; border-bottom: 1px solid #e0d7d5; padding-bottom: 10px; }
        .folder-path { color: #9e9e9e; font-size: 0.75em; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 4px; }
        .recipe-link { color: #8d6e63; text-decoration: none; font-size: 1.2em; font-weight: bold; }
        .recipe-link:hover { color: #5d4037; }
    </style>
</head>
<body>
    <h1>Loving Memories of Mildred</h1>
    <p style="text-align:center;"><em>A nested collection of family recipes.</em></p>
    <hr>

    <div class="recipe-list">
    {%- for recipe in collections.all | sortByFilePath -%}
      {%- if recipe.url != '/' -%}
        <div class="recipe-item">
            <span class="folder-path">{{ recipe.filePathStem | replace("/index", "") | cleanPath }}</span>
            <a href="{{ recipe.url }}" class="recipe-link">🌸 {{ recipe.fileSlug | replace("-", " ") | replace("_", " ") | capitalize }}</a>
        </div>
      {%- endif -%}
    {%- endfor -%}
    </div>
</body>
</html>
